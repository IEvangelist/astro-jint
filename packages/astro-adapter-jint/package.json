{
  "name": "astro-adapter-jint",
  "version": "0.1.0",
  "private": true,
  "description": "Astro adapter that renders on-demand routes inside Jint, hosted by ASP.NET Core.",
  "type": "module",
  "keywords": [
    "astro-adapter",
    "withastro",
    "jint",
    "aspnetcore",
    "ssr"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server.js": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "astro": "^7.3.6",
    "typescript": "^7.0.2"
  }
}
