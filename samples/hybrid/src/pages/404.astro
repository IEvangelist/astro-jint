---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Page not found">
  <section class="lost">
    <BrandMark class="lost-mark" />
    <PageHead title="Page not found" how={false}>
      <p class="lead">There is nothing at this address. <a href="/">Back to the home page</a>.</p>
    </PageHead>
  </section>
</Base>
