---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Something went wrong">
  <section class="lost">
    <BrandMark class="lost-mark" />
    <PageHead title="Something went wrong" how={false}>
      <p class="lead">The page could not be rendered. <a href="/">Back to the home page</a>.</p>
    </PageHead>
  </section>
</Base>
