---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { posts } from '../../data/posts';
---
<Base title="Blog">
  <PageHead title="Blog" />
  <div class="wrap block">
    <ul class="rows">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>{post.title}</a>
          <p>{post.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
