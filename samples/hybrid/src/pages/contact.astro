---
export const prerender = false;

import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const errors: { name?: string; message?: string } = {};
let name = '';
let message = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  name = String(form.get('name') ?? '').trim();
  message = String(form.get('message') ?? '').trim();

  if (!name) {
    errors.name = 'Tell us your name.';
  }
  if (message.length < 5) {
    errors.message = 'The message needs at least five characters.';
  }

  if (!errors.name && !errors.message) {
    Astro.cookies.set('contact-name', name, { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 600 });
    return Astro.redirect('/contact', 303);
  }

  Astro.response.status = 400;
}

const thanks = Astro.cookies.get('contact-name')?.value;
---
<Base title="Contact">
  <PageHead title="Contact" />
  <div class="wrap block contact-grid">
    <div>
      {thanks && <p id="thanks" class="plate thanks">Thanks for your message, {thanks}!</p>}
      <form class="plate form" method="post" action="/contact">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" value={name} autocomplete="name" aria-invalid={errors.name ? 'true' : undefined} aria-describedby={errors.name ? 'name-error' : undefined} />
          {errors.name && <p class="error" id="name-error">{errors.name}</p>}
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="4" aria-invalid={errors.message ? 'true' : undefined} aria-describedby={errors.message ? 'message-error' : undefined}>{message}</textarea>
          {errors.message && <p class="error" id="message-error">{errors.message}</p>}
        </div>
        <button class="button" type="submit">Send</button>
      </form>
    </div>
    <aside class="plate steps">
      <h2>What this form does</h2>
      <ol>
        <li>It posts to this page, which Astro renders in Jint.</li>
        <li>Astro validates the fields and answers 400 with messages when something is missing.</li>
        <li>A valid message sets an HttpOnly cookie and redirects with 303.</li>
      </ol>
    </aside>
  </div>
</Base>
