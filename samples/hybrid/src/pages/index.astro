---
import Base from '../layouts/Base.astro';
import ServerClock from '../components/ServerClock.astro';

const builtAt = new Date().toISOString();
---
<Base title="Home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Hybrid Astro on Jint</h1>
        <p class="lead">Pages built once, and pages rendered per request, from one Astro project hosted by ASP.NET Core.</p>
        <div class="actions">
          <a class="button" href="/time">Try a live page</a>
          <a class="button button-quiet" href="/blog">Browse static pages</a>
        </div>
      </div>
      <div class="plate fix">
        <div class="fix-land">
          <p>
            This page was generated at build time:{' '}
            <time id="built-at" class="stamp" datetime={builtAt}>{builtAt}</time>. The host serves it as a file.
          </p>
        </div>
        <svg class="coast" viewBox="0 0 320 64" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="coast-land" d="M0 0 H320 V20 C292 30 268 10 236 18 S176 36 140 24 S78 6 44 20 S12 30 0 22 Z" />
          <path class="coast-line" d="M320 20 C292 30 268 10 236 18 S176 36 140 24 S78 6 44 20 S12 30 0 22" />
          <path class="coast-line coast-line-2" d="M320 27 C292 37 268 17 236 25 S176 43 140 31 S78 13 44 27 S12 37 0 29" />
          <path class="coast-line coast-line-3" d="M320 34 C292 44 268 24 236 32 S176 50 140 38 S78 20 44 34 S12 44 0 36" />
          <path class="coast-line coast-line-4" d="M320 41 C292 51 268 31 236 39 S176 57 140 45 S78 27 44 41 S12 51 0 43" />
          <path class="coast-line coast-line-5" d="M320 48 C292 58 268 38 236 46 S176 64 140 52 S78 34 44 48 S12 58 0 50" />
        </svg>
        <div class="fix-sea">
          <p class="fix-caption">The clock below is a server island, rendered on demand while the rest stays a file.</p>
          <div class="fix-deep">
            <ServerClock server:defer>
              <p slot="fallback" class="clock clock-loading">Loading the server time...</p>
            </ServerClock>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap block routes">
    <section class="plate route-plate" data-mode="static">
      <h2 class="mark" data-mode="static">Generated at build time</h2>
      <ul class="route-list">
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a> and its posts</li>
        <li><a href="/products">Products</a> (the list)</li>
      </ul>
    </section>
    <section class="plate route-plate" data-mode="on-demand">
      <h2 class="mark" data-mode="on-demand">Rendered on demand in Jint</h2>
      <ul class="route-list">
        <li><a href="/time">Time</a>, with an API call from the browser</li>
        <li><a href="/products/1">A product</a>, with a currency switch and a 404 for unknown ones</li>
        <li><a href="/contact">Contact</a>: a form, a cookie and a redirect</li>
        <li><a href="/session">Session</a>, stored by ASP.NET Core</li>
        <li><a href="/me">Me</a>: the user as ASP.NET Core sees it</li>
        <li><a href="/diagnostics">Diagnostics</a>: environment, client address and request</li>
        <li><a href="/api/echo?hello=world">The echo endpoint</a></li>
      </ul>
    </section>
  </div>

  <section class="wrap block">
    <div class="passage">
      <div class="passage-copy">
        <h2>How a request is served</h2>
        <p>Each request takes one of two paths, decided by whether the build wrote a file for it.</p>
      </div>
      <ol class="course">
        <li>The browser asks ASP.NET Core for a page.</li>
        <li>
          The host looks for a file the build wrote for that address.
          <ul class="fork">
            <li class="mark" data-mode="static">File found: the host serves the file. No JavaScript runs.</li>
            <li class="mark" data-mode="on-demand">No file: Astro renders the page in Jint, and the host sends the result.</li>
          </ul>
        </li>
      </ol>
    </div>
  </section>

  <section class="wrap block">
    <div class="plate status">
      <h2>Still a prototype</h2>
      <div>
        <p>It runs on a preview build of Jint 5. Some Astro features are not supported yet, and the gaps are tracked in the repository.</p>
        <a href="https://github.com/IEvangelist/astro-jint/blob/main/docs/conformance.md">See the tracked gaps</a>
      </div>
    </div>
  </section>
</Base>
