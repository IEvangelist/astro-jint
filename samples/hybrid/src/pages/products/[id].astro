---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { products } from '../../data/products';

const product = products.find((candidate) => candidate.id === Astro.params.id);
if (!product) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const euro = Astro.url.searchParams.get('currency')?.toLowerCase() === 'eur';
const price = euro ? `EUR ${(product.price * 0.92).toFixed(2)}` : `USD ${product.price.toFixed(2)}`;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---
<Base title={product.name}>
  <PageHead title={product.name} />
  <div class="wrap block">
    <div class="plate product">
      <p id="price" class="price-big">{price}</p>
      <div class="product-body">
        <p>{product.description}</p>
        <div class="product-actions">
          <a class="button button-quiet" href={euro ? '?currency=usd' : '?currency=eur'}>Show the price in {euro ? 'USD' : 'EUR'}</a>
          <a href="/products">All products</a>
        </div>
      </div>
    </div>
  </div>
</Base>
