<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AstroJint.Conformance</RootNamespace>
    <!-- The tests use the ambient test timeouts; threading a CancellationToken through every call adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite only uses the public API of the host, like an application would. -->
    <ProjectReference Include="..\..\src\AstroJint.AspNetCore\AstroJint.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
