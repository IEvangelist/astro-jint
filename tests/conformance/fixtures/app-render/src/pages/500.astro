---
const { error } = Astro.props;

// The custom-500 fixture of upstream has a 500 page that shows the error and another one that throws. This is both: it
// shows the error of throws.astro and throws for every other one, so that the other pages of the fixture that fail (throws-other,
// not-response, a missing client address, a failed streaming render) answer with the bare empty 500 of a failing 500 page.
if (error !== 'some error') {
  throw 'custom 500 fail';
}
---
<html lang="en">
  <head>
    <title>Server error - Custom 500</title>
    <style>
      body { background-color: #fcc; color: #c00; }
      h1 { font-family: monospace; }
    </style>
  </head>
  <body>
    <h1>Server error</h1>
    <p>{error}</p>
  </body>
</html>
