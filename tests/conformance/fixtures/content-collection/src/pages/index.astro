---
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = await getCollection('posts');
---

<html lang="en">
  <head>
    <title>Posts</title>
  </head>
  <body>
    <h1>Posts</h1>
    <ul>
      {posts.map((post) => <li><a href={`/posts/${post.id}`}>{post.data.title}</a></li>)}
    </ul>
  </body>
</html>
