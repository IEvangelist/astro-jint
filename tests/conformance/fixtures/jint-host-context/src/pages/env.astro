---
import { GREETING, API_TOKEN, getSecret } from 'astro:env/server';

export const prerender = false;
---
<html>
  <head><title>Env</title></head>
  <body>
    <p id="greeting">{GREETING}</p>
    <p id="token">{API_TOKEN ?? 'unset'}</p>
    <p id="secret">{getSecret('API_TOKEN') ?? 'unset'}</p>
  </body>
</html>
