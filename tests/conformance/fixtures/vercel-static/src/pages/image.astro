---
import { Image } from 'astro:assets';
import astro from '../assets/astro.jpeg';
import penguin from '../assets/penguin.svg';
---

<html>
	<head>
		<title>Image</title>
	</head>
	<body>
		<div id="basic-image">
			<Image src={astro} alt="Astro" />
		</div>
		<div id="svg">
			<Image src={penguin} alt="Penguin" />
		</div>
	</body>
</html>
